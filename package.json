{
  "name": "stable-lords",
  "type": "module",
  "packageManager": "bun@1.3.11",
  "productName": "Stable Lords",
  "private": true,
  "version": "2.1.0",
  "description": "Manage your stable of warriors, train fighting styles, and compete in the arena!",
  "author": "Stable Lords Team",
  "main": "electron/main.ts",
  "scripts": {
    "dev": "vite",
    "electron:dev": "bun run dev & sleep 5 && electron-forge start",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "electron:build": "vite build && electron-forge make",
    "electron:build:all": "vite build && electron-forge make --platform=all",
    "electron:pack": "vite build && electron-forge package",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "test": "npx vitest run",
    "test:watch": "npx vitest",
    "test:slow": "npx vitest run --config vitest.config.slow.ts",
    "test:all": "npx vitest run --config vitest.config.all.ts",
    "test:bun": "bun test --isolate",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "e2e:debug": "playwright test --debug",
    "type-check": "node node_modules/typescript7/bin/tsc --build --force",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "oracle:daily": "bun run src/scripts/daily_oracle.ts",
    "bard:daily": "bunx tsx src/scripts/daily_bard.ts",
    "narrative-validate": "bun run scripts/narrative_validate.ts"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@google/generative-ai": "^0.24.1",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-virtual": "^3.14.9",
    "@testing-library/dom": "^10.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.43.0",
    "lucide-react": "^0.462.0",
    "next-themes": "^0.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "^2.15.4",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.4.3"
  },
  "overrides": {

    "fast-uri": "3.1.5",
    "ip-address": "10.3.1",
    "tmp": "0.2.7",
    "tar": "7.5.22"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-router": "^1.170.25",
    "@tanstack/router-vite-plugin": "^1.167.29",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/howler": "^2.2.13",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@typescript/typescript6": "6.0.2",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.5.4",
    "comlink": "^4.4.2",
    "electron": "^43.3.0",
    "eslint": "^10.8.1",
    "eslint-plugin-jsdoc": "^64.0.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "howler": "^2.2.4",
    "immer": "^11.1.16",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.67.0",
    "typescript7": "npm:typescript@7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "zustand": "^5.0.14"
  },
  "build": {
    "appId": "com.stablelords.app",
    "productName": "Stable Lords",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.ts"
    },
    "asar": false,
    "mac": {
      "category": "public.app-category.games",
      "icon": "public/icons/icon-512.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "public/icons/icon-512.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "config": {
      "forge": {
        "packagerConfig": {},
        "rebuildConfig": {},
        "makers": [
          {
            "name": "@electron-forge/maker-squirrel",
            "config": {
              "name": "stable_lords"
            }
          },
          {
            "name": "@electron-forge/maker-zip",
            "platforms": [
              "darwin"
            ]
          },
          {
            "name": "@electron-forge/maker-dmg",
            "config": {}
          },
          {
            "name": "@electron-forge/maker-deb",
            "config": {}
          },
          {
            "name": "@electron-forge/maker-rpm",
            "config": {}
          }
        ]
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
