{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "composite": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "@/*": ["./src/*"],
      "#scripts/*": ["./scripts/*"]
    },
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": true,
    "target": "ES2020",
    "types": ["node", "vitest/globals", "@testing-library/jest-dom/vitest"],
    "useDefineForClassFields": true
  },
  "include": [
    "src",
    "electron/main.ts",
    "scripts/daily_bard.ts",
    "scripts/daily_oracle.ts",
    "scripts/nodeArchiveService.ts",
    "scripts/simulation-harness.ts",
    "scripts/tournament-dominance.ts",
    "scripts/balance-lab.ts",
    "scripts/lab-overrides.ts",
    "scripts/liveness-diag.ts",
    "scripts/roundtrip-check.ts",
    "scripts/run-fight.ts",
    "scripts/style-probe.ts",
    "scripts/world-diag.ts"
  ]
}
