{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node", "@playwright/test"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "composite": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["./src/*"],
      "#scripts/*": ["./scripts/*"]
    }
  },
  "include": [
    "e2e/**/*.ts",
    "scripts/**/*.ts",
    "playwright.config.ts",
    "vitest.config.ts",
    "vitest.config.all.ts",
    "vitest.config.slow.ts",
    "tailwind.config.ts"
  ],
  "exclude": [
    "scripts/run-fight.ts",
    "scripts/build-fight.ts",
    "scripts/strip-junk-jsdoc.ts",
    "scripts/advisor-e2e.ts",
    "scripts/advisor-probe.ts",
    "scripts/emergent-report.ts",
    "scripts/liveness-diag.ts",
    "scripts/world-diag.ts",
    "scripts/balance-lab.ts",
    "scripts/lab-overrides.ts",
    "scripts/style-probe.ts",
    "scripts/daily_bard.ts",
    "scripts/daily_oracle.ts",
    "scripts/nodeArchiveService.ts",
    "scripts/simulation-harness.ts",
    "scripts/tournament-dominance.ts"
  ]
}
